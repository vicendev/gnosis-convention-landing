---
import { cn } from '@/lib/utils';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn("flex items-center justify-center gap-3 sm:gap-4 px-4 select-none", className)}>
  <div class="flex-1 h-px max-w-xs bg-gradient-to-r from-transparent via-iga-copper/40 to-transparent"></div>
  
  <!-- Decorative star -->
  <div class="flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6 rounded-full border border-iga-copper/30 bg-gradient-to-br from-iga-gold/10 to-iga-copper/10 flex-shrink-0">
    <svg
      viewBox="0 0 24 24"
      class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-iga-copper/70"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12 2L9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61z"/>
    </svg>
  </div>
  
  <div class="flex-1 h-px max-w-xs bg-gradient-to-r from-transparent via-iga-copper/40 to-transparent"></div>
</div>
