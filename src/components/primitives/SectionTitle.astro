---
import { cn } from '@/lib/utils';

interface Props {
  title: string;
  subtitle?: string;
  class?: string;
}

const { title, subtitle, class: className } = Astro.props;
---

<div class={cn("text-center", className)}>
  <h2 class="font-cinzel-regular text-clamp-h2 font-bold text-iga-navy uppercase tracking-wide">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-3 font-spectral text-lg text-iga-foreground/70 italic">
      {subtitle}
    </p>
  )}
</div>
