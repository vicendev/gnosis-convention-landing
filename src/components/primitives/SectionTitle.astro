---
import { cn } from '@/lib/utils';

interface Props {
  title: string;
  subtitle?: string;
  class?: string;
}

const { title, subtitle, class: className } = Astro.props;
---

<div class={cn("text-center", className)}>
  <h2 class="font-cinzel-regular font-bold text-iga-navy uppercase tracking-wide"
      style="font-size: clamp(1.4rem, 4vw, 2.5rem);"
  >
    {title}
  </h2>
  {subtitle && (
    <p class="mt-3 font-serif text-lg text-iga-foreground/70 italic">
      {subtitle}
    </p>
  )}
</div>
