---
import Container from '@/components/primitives/Container.astro';
import SectionTitle from '@/components/primitives/SectionTitle.astro';
import { cn } from '@/lib/utils';
import type { ConventionMap } from '@/data/types';

interface Props {
  map: ConventionMap[];
  sectionTitle?: string;
  sectionSubtitle?: string;
  directionsLabel?: string;
  class?: string;
}

const { map: maps, sectionTitle = "Ubicación", sectionSubtitle, directionsLabel = "Cómo llegar", class: className } = Astro.props;

const hasMultiple = maps.length > 1;

// Resolve all URLs at build time per map entry
const resolvedMaps = maps.map(m => ({
  label: m.label,
  embedUrl: m.embedUrl ?? `https://maps.google.com/maps?q=${m.lat},${m.lng}&z=${m.zoom}&output=embed`,
  placeName: m.placeName,
  address: m.address,
  advice: m.advice ?? null,
  instructions: m.instructions,
  directionsUrl: m.directionsUrl ?? `https://www.google.com/maps/dir/?api=1&destination=${m.lat},${m.lng}`,
  viewMapUrl: m.viewMapUrl ?? m.mapsUrl ?? `https://www.google.com/maps?q=${m.lat},${m.lng}`,
  directionsVideoUrl: m.directionsVideoUrl ?? null,
}));

const initial = resolvedMaps[0];
---

<section id="map" class={cn("py-16 md:py-24 bg-iga-background", "animate-fade-up animate-on-scroll", className)}>
  <Container class="flex flex-col items-center gap-12">
    <SectionTitle title={sectionTitle} subtitle={sectionSubtitle} />

    {/* Map container with ornate frame */}
    <div class="w-full flex flex-col items-center gap-6">
      {/* Decorative top line */}
      <div class="flex items-center gap-3 w-full max-w-4xl">
        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-iga-copper/40 to-transparent"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-iga-copper/50 flex-shrink-0"></div>
        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-iga-copper/40 to-transparent"></div>
      </div>

      {/* Toggle pills — only when multiple maps configured */}
      {hasMultiple && (
        <div id="map-pills" class="flex flex-wrap justify-center gap-3 p-1.5 rounded-xl border border-iga-copper/30 bg-iga-copper/5">
          {resolvedMaps.map((m, i) => (
            <button
              data-index={i}
              data-active={i === 0}
              class={cn(
                "flex items-center gap-2 px-6 py-2.5 rounded-lg font-cinzel-regular text-sm uppercase tracking-wide transition-all duration-200 min-h-[44px]",
                i === 0
                  ? "bg-iga-copper text-white shadow-md"
                  : "bg-iga-background/60 text-iga-foreground border border-iga-copper/30 hover:bg-iga-copper/10"
              )}
            >
              <svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              {m.label}
            </button>
          ))}
        </div>
      )}

      {/* Dynamic location info — shows active map's place + address */}
      <div id="map-location-info" class="flex flex-col items-center gap-1 text-center">
        <p id="map-place" class="font-serif text-iga-copper italic"
           style="font-size: clamp(1rem, 2vw, 1.25rem);"
        >
          {initial.placeName}
        </p>
        <p id="map-address" class="font-sans text-iga-foreground/75 text-sm sm:text-base">
          {initial.address}
        </p>
        <div id="map-advice" class="mt-3 mx-auto inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-iga-navy/20 bg-iga-navy/[0.06] text-iga-navy text-base sm:text-lg font-sans" style={initial.advice ? "" : "display: none;"}>
          <svg width="20" height="20" class="shrink-0 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 16v-4"/>
            <path d="M12 8h.01"/>
          </svg>
          <span id="map-advice-text" class={initial.advice?.bold ? "font-semibold" : "font-normal"}>
            {initial.advice?.label}
          </span>
        </div>
      </div>

      {/* Map frame */}
      <div class="relative w-full max-w-4xl">
        {/* Outer decorative border */}
        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-br from-iga-copper/40 via-iga-gold/20 to-iga-copper/40 blur-sm"></div>

        {/* Main frame */}
        <div class="relative rounded-xl overflow-hidden shadow-2xl border-2 border-iga-copper/30 bg-iga-foreground/5">
          {/* Corner ornaments */}
          <div class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-iga-gold/60 rounded-tl-lg z-10"></div>
          <div class="absolute top-0 right-0 w-8 h-8 border-t-2 border-r-2 border-iga-gold/60 rounded-tr-lg z-10"></div>
          <div class="absolute bottom-0 left-0 w-8 h-8 border-b-2 border-l-2 border-iga-gold/60 rounded-bl-lg z-10"></div>
          <div class="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-iga-gold/60 rounded-br-lg z-10"></div>

          <div class="w-full h-[400px] relative bg-iga-background">
            {/* Loading spinner */}
            <div id="map-loader" class="absolute inset-0 flex flex-col items-center justify-center gap-3 z-10" style="display: none;">
              <svg class="animate-spin h-8 w-8 text-iga-copper" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span class="text-xs text-iga-foreground/40 font-sans">Cargando mapa...</span>
            </div>
            <iframe
              id="map-iframe"
              data-src={initial.embedUrl}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Mapa de ubicación"
              class="lazy-load"
            ></iframe>
          </div>
        </div>
      </div>

      {/* Decorative bottom line */}
      <div class="flex items-center gap-3 w-full max-w-4xl">
        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-iga-copper/40 to-transparent"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-iga-copper/50 flex-shrink-0"></div>
        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-iga-copper/40 to-transparent"></div>
      </div>
    </div>

    {/* Instructions — hidden when empty */}
    <div id="map-instructions" class="max-w-2xl text-center font-serif text-base text-iga-foreground/80 italic leading-relaxed" style={initial.instructions ? "" : "display: none;"}>
      {initial.instructions}
    </div>

    {/* Directions video — optional per map */}
    <div id="map-video-section" class="w-full max-w-3xl flex flex-col items-center gap-4" style={initial.directionsVideoUrl ? "" : "display: none;"}>
      <h3 class="font-cinzel-regular text-lg text-iga-navy uppercase tracking-wide">
        {directionsLabel}
      </h3>
      <div class="relative w-full rounded-xl overflow-hidden shadow-lg border-2 border-iga-copper/20 bg-black">
        <div class="video-loader absolute inset-0 flex flex-col items-center justify-center gap-3 z-10">
          <svg class="animate-spin h-8 w-8 text-iga-copper" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span class="text-xs text-white/40 font-sans">Cargando video...</span>
        </div>
        <div class="w-full aspect-video">
          <video
            id="map-directions-video"
            data-src={initial.directionsVideoUrl}
            controls
            playsinline
            preload="none"
            class="w-full h-full object-cover lazy-load"
            oncanplay="this.parentNode.parentNode.querySelector('.video-loader').style.display='none'"
          >
            Tu navegador no soporta el elemento de video.
          </video>
        </div>
      </div>
    </div>

    {/* Action cards */}
    <div class="w-full max-w-3xl grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a
        id="map-dir-link"
        href={initial.directionsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center gap-4 p-6 rounded-xl border-2 border-iga-copper/30 bg-gradient-to-b from-iga-copper/5 to-white text-center transition-all duration-200 hover:bg-iga-copper/10 hover:shadow-lg hover:shadow-iga-copper/20 hover:border-iga-copper/60 hover:-translate-y-1 active:scale-[0.98] group cursor-pointer"
      >
        <div class="flex items-center justify-center w-14 h-14 rounded-full bg-gradient-to-br from-iga-copper/20 to-iga-gold/20 group-hover:from-iga-copper/30 group-hover:to-iga-gold/30 transition-all duration-200">
          <svg width="28" height="28" viewBox="0 0 24 24" class="text-iga-copper">
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 11l19-9-9 19-2-8-8-2z"/>
          </svg>
        </div>
        <div class="flex flex-col items-center gap-1">
          <h3 class="font-cinzel-regular text-base font-bold text-iga-navy uppercase tracking-wide">
            {directionsLabel}
          </h3>
          <p class="text-sm text-iga-foreground/70 leading-relaxed">
            Abrir navegación paso a paso desde tu ubicación
          </p>
        </div>
        <span class="inline-flex items-center gap-1.5 mt-1 px-5 py-2.5 rounded-lg bg-iga-copper text-white text-sm font-sans font-semibold transition-all duration-200 group-hover:bg-iga-copper/90 group-hover:shadow-md shadow-iga-copper/30">
          Abrir en Google Maps
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17l9.2-9.2M17 17V7H7"/>
          </svg>
        </span>
      </a>

      <a
        id="map-view-link"
        href={initial.viewMapUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center gap-4 p-6 rounded-xl border-2 border-iga-copper/30 bg-gradient-to-b from-iga-copper/5 to-white text-center transition-all duration-200 hover:bg-iga-copper/10 hover:shadow-lg hover:shadow-iga-copper/20 hover:border-iga-copper/60 hover:-translate-y-1 active:scale-[0.98] group cursor-pointer"
      >
        <div class="flex items-center justify-center w-14 h-14 rounded-full bg-gradient-to-br from-iga-copper/20 to-iga-gold/20 group-hover:from-iga-copper/30 group-hover:to-iga-gold/30 transition-all duration-200">
          <svg width="28" height="28" viewBox="0 0 24 24" class="text-iga-copper">
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </div>
        <div class="flex flex-col items-center gap-1">
          <h3 class="font-cinzel-regular text-base font-bold text-iga-navy uppercase tracking-wide">
            Ver mapa completo
          </h3>
          <p class="text-sm text-iga-foreground/70 leading-relaxed">
            Abrir Google Maps con toda la información del lugar
          </p>
        </div>
        <span class="inline-flex items-center gap-1.5 mt-1 px-5 py-2.5 rounded-lg bg-iga-copper text-white text-sm font-sans font-semibold transition-all duration-200 group-hover:bg-iga-copper/90 group-hover:shadow-md shadow-iga-copper/30">
          Abrir en Google Maps
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17l9.2-9.2M17 17V7H7"/>
          </svg>
        </span>
      </a>
    </div>
  </Container>

  <!-- Serializable map data for the toggle script -->
  <div id="maps-data" data-maps={JSON.stringify(resolvedMaps)} hidden></div>

  <script>
    import { initAnimateOnScroll } from '@/lib/animate-on-scroll';
    import { initLazyLoad } from '@/lib/lazy-load';

    function initMapToggle() {
      const dataEl = document.getElementById('maps-data');
      if (!dataEl) return;
      const raw = dataEl.getAttribute('data-maps');
      if (!raw) return;
      const mapsData = JSON.parse(raw);
      if (mapsData.length <= 1) return;

      const iframe = document.getElementById('map-iframe') as HTMLIFrameElement | null;
      const loader = document.getElementById('map-loader');
      const pills = document.querySelectorAll<HTMLButtonElement>('#map-pills button');
      const placeEl = document.getElementById('map-place');
      const addressEl = document.getElementById('map-address');
      const adviceEl = document.getElementById('map-advice');
      const instructionsEl = document.getElementById('map-instructions');
      const dirLink = document.getElementById('map-dir-link') as HTMLAnchorElement | null;
      const viewLink = document.getElementById('map-view-link') as HTMLAnchorElement | null;
      const videoSection = document.getElementById('map-video-section');
      const videoEl = document.getElementById('map-directions-video') as HTMLVideoElement | null;

      let currentIndex = 0;
      let timeoutId: number | null = null;

      function switchMap(index: number) {
        if (index === currentIndex || !iframe) return;
        const data = mapsData[index];

        if (loader) loader.style.display = 'flex';

        iframe.src = data.embedUrl;

        if (timeoutId) clearTimeout(timeoutId);
        timeoutId = window.setTimeout(() => {
          if (loader) loader.style.display = 'none';
        }, 5000);

        if (placeEl) placeEl.textContent = data.placeName;
        if (addressEl) addressEl.textContent = data.address;
        if (adviceEl) {
          const adviceText = document.getElementById('map-advice-text');
          if (adviceText) {
            adviceText.textContent = data.advice?.label ?? '';
            adviceText.className = data.advice?.bold ? 'font-semibold' : 'font-normal';
          }
          adviceEl.style.display = data.advice ? '' : 'none';
        }
        if (instructionsEl) {
          instructionsEl.textContent = data.instructions;
          instructionsEl.style.display = data.instructions ? '' : 'none';
        }

        if (dirLink) dirLink.href = data.directionsUrl;
        if (viewLink) viewLink.href = data.viewMapUrl;

        if (data.directionsVideoUrl) {
          if (videoSection) videoSection.style.display = '';
          if (videoEl) {
            videoEl.src = data.directionsVideoUrl;
            videoEl.load();
          }
        } else {
          if (videoSection) videoSection.style.display = 'none';
          if (videoEl) {
            videoEl.removeAttribute('src');
            videoEl.load();
          }
        }

        pills.forEach((pill, i) => {
          pill.classList.toggle('bg-iga-copper', i === index);
          pill.classList.toggle('text-white', i === index);
          pill.classList.toggle('shadow-md', i === index);
          pill.classList.toggle('bg-iga-background/60', i !== index);
          pill.classList.toggle('text-iga-foreground', i !== index);
          pill.classList.toggle('border', i !== index);
          pill.classList.toggle('border-iga-copper/30', i !== index);
          pill.setAttribute('data-active', String(i === index));
        });

        currentIndex = index;
      }

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const index = parseInt(pill.getAttribute('data-index') || '0');
          switchMap(index);
        });
      });

      if (iframe) {
        iframe.addEventListener('load', () => {
          if (loader) loader.style.display = 'none';
          if (timeoutId) clearTimeout(timeoutId);
        });
      }

      /* ── Wiggle the inactive toggle pill on scroll-in ── */
      const section = document.getElementById('map');
      const pillsContainer = document.getElementById('map-pills');
      if (section && pillsContainer) {
        const observer = new IntersectionObserver((entries) => {
          const entry = entries[0];
          if (!entry.isIntersecting) return;
          setTimeout(() => {
            const inactive = pillsContainer.querySelector<HTMLElement>('button[data-active="false"]');
            if (inactive) {
              inactive.style.animation = 'wiggle 0.8s ease-in-out';
              inactive.addEventListener('animationend', () => {
                inactive.style.animation = '';
              }, { once: true });
            }
          }, 800);
          observer.disconnect();
        }, { threshold: 0.3 });
        observer.observe(section);
      }
    }

    initAnimateOnScroll();
    initLazyLoad();
    initMapToggle();
  </script>
</section>
