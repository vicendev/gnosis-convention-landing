---
import { Icon } from 'astro-icon/components';
import Container from '@/components/primitives/Container.astro';
import SectionTitle from '@/components/primitives/SectionTitle.astro';
import { cn } from '@/lib/utils';
import { ASSET_BASE_URL } from '@/config/env';

interface Props {
  programPdf: string;
  sectionTitle?: string;
  sectionSubtitle?: string;
  class?: string;
}

const {
  programPdf,
  sectionTitle = "Programa Convención",
  sectionSubtitle = "Descarga el programa completo de la XI Convención",
  class: className,
} = Astro.props;
---

<section id="program" class={cn("py-16 md:py-24", "animate-fade-up animate-on-scroll", className)}>
  <Container class="flex flex-col items-center gap-12">
    <SectionTitle title={sectionTitle} subtitle={sectionSubtitle} />

    <div class="relative w-full max-w-xl">
      <div class="absolute -inset-1 rounded-2xl bg-gradient-to-br from-iga-copper/40 via-iga-gold/20 to-iga-copper/40 blur-sm"></div>

      <div class="relative rounded-xl overflow-hidden shadow-2xl border-2 border-iga-copper/30 bg-white">
        <div class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-iga-gold/60 rounded-tl-lg z-20"></div>
        <div class="absolute top-0 right-0 w-8 h-8 border-t-2 border-r-2 border-iga-gold/60 rounded-tr-lg z-20"></div>
        <div class="absolute bottom-0 left-0 w-8 h-8 border-b-2 border-l-2 border-iga-gold/60 rounded-bl-lg z-20"></div>
        <div class="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-iga-gold/60 rounded-br-lg z-20"></div>

        <div class="flex flex-col items-center gap-6 px-8 py-12 md:px-12 md:py-16">
          <div class="w-16 h-16 rounded-full bg-iga-copper/10 flex items-center justify-center">
            <Icon name="lucide:file-text" class="h-8 w-8 text-iga-copper" />
          </div>

          <div class="text-center">
            <p class="font-cinzel-regular text-xl uppercase tracking-wide text-iga-navy mb-2">
              Programa Oficial
            </p>
            <p class="font-serif text-base text-iga-foreground/70 italic">
              PDF completo con las actividades de la XI Convención
            </p>
          </div>

          <a
            href={`${ASSET_BASE_URL}${programPdf}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-gradient-to-r from-iga-copper to-iga-copper/90 text-white hover:from-iga-copper/90 hover:to-iga-copper font-sans text-base font-bold shadow-lg hover:shadow-xl transition-all duration-300 min-h-[52px] border border-iga-gold/20 animate-wiggle"
          >
            <Icon name="lucide:download" class="h-5 w-5 transition-transform duration-300 group-hover:scale-110" />
            <span>Ver Programa</span>
            <Icon name="lucide:arrow-up-right" class="h-4 w-4 opacity-60 transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>
      </div>
    </div>
  </Container>

  <script>
    import { initAnimateOnScroll } from '@/lib/animate-on-scroll';
    initAnimateOnScroll();
  </script>
</section>
